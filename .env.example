APP_NAME=NutriBuddy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://example.com

# Set to a persistent shared directory outside the release folder in production.
# Keep this directory with the database backup when moving the application.
# PUBLIC_STORAGE_PATH=/var/www/nutribuddy-shared/public

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

AISENSY_ENABLED=true
# Enable only on an isolated UAT deployment where APP_ENV=uat.
AISENSY_UAT_OTP_ENABLED=false
AISENSY_API_KEY=
AISENSY_ENDPOINT=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_OTP_CAMPAIGN=
AISENSY_ORDER_PAID_CAMPAIGN=
AISENSY_WEBHOOK_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nutribuddy
DB_USERNAME=nutribuddy_user
DB_PASSWORD=

# Keep this directory on persistent/shared storage across code deployments.
# Leave empty to use storage/app/public inside this checkout.
PUBLIC_STORAGE_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

COMPANY_PHONE="+91 98765 43210"
COMPANY_EMAIL=support@example.com
COMPANY_WEBSITE=https://example.com
